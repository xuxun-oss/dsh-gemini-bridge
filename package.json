{
  "name": "dsh-gemini-bridge",
  "version": "1.1.0",
  "description": "DeepSeek Harness 全能插件：识别/生图/改图一体化，无需切换模型——用常规 DeepSeek 模型即可自动调用 Gemini 视觉与生图模型（gemini_vision / gemini_generate_image / gemini_optimize_image），生成后自动视觉自检反馈，优于 modlens，直接复用你自己的 Gemini API Key。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "gemini",
    "vision",
    "image-generation",
    "multimodal"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  }
}