{
  "name": "dsh-gemini-bridge",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：为 DeepSeek 模型桥接 Google Gemini 的多模态识别与图像生成。注册 gemini_vision / gemini_generate_image / gemini_optimize_image 三个工具，设置页填写 API Key 并自动/手动选择视觉与生图模型，生图后自动识别检查并迭代优化。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "gemini",
    "vision",
    "image-generation",
    "multimodal"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  }
}
